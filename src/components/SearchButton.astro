---
// Search button that opens Pagefind search modal
---

<button id="search-toggle" class="search-toggle" aria-label="Search">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.35-4.35"></path>
  </svg>
  <span class="search-shortcut">/</span>
</button>

<div id="search-modal" class="search-modal" hidden>
  <div class="search-modal-backdrop"></div>
  <div class="search-modal-content">
    <div class="search-modal-header">
      <input type="search" id="modal-search-input" placeholder="Search documentation..." autocomplete="off" />
      <button id="search-close" aria-label="Close search">×</button>
    </div>
    <div id="modal-search-results" class="search-modal-results"></div>
  </div>
</div>

<script>
  (function() {
    const toggle = document.getElementById('search-toggle');
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('modal-search-input');
    const results = document.getElementById('modal-search-results');
    const close = document.getElementById('search-close');
    let pagefind = null;

    async function initPagefind() {
      try {
        pagefind = await import('pagefind');
        await pagefind.init();
      } catch (e) {
        console.log('Pagefind not available:', e);
      }
    }

    initPagefind();

    function openSearch() {
      modal.hidden = false;
      input.focus();
      document.body.style.overflow = 'hidden';
    }

    function closeSearch() {
      modal.hidden = true;
      input.value = '';
      results.innerHTML = '';
      document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', openSearch);
    close?.addEventListener('click', closeSearch);
    modal?.querySelector('.search-modal-backdrop')?.addEventListener('click', closeSearch);

    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !modal?.hidden === false) {
        e.preventDefault();
        openSearch();
      }
      if (e.key === 'Escape' && !modal?.hidden) {
        closeSearch();
      }
    });

    let searchTimeout;
    input?.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      const query = e.target.value.trim();
      if (query.length < 2 || !pagefind) {
        results.innerHTML = '';
        return;
      }
      searchTimeout = setTimeout(async () => {
        const res = await pagefind.search(query);
        results.innerHTML = '';
        if (res.results.length === 0) {
          results.innerHTML = '<p class="no-results">No results found</p>';
          return;
        }
        const ul = document.createElement('ul');
        ul.className = 'search-results';
        res.results.slice(0, 8).forEach(r => {
          const li = document.createElement('li');
          li.innerHTML = '<a href="' + r.url + '"><h4>' + (r.meta.title || r.url) + '</h4><p>' + r.excerpt + '</p></a>';
          ul.appendChild(li);
        });
        results.appendChild(ul);
      }, 200);
    });
  })();
</script>

<style>
  .search-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    color: var(--sl-color-gray-1);
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.15s ease;
  }
  .search-toggle:hover {
    border-color: var(--phoenix-ember);
    color: var(--phoenix-ember-hi);
  }
  .search-shortcut {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.15rem 0.4rem;
    background: var(--sl-color-hairline);
    border-radius: 0.25rem;
    color: var(--sl-color-gray-2);
  }
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }
  .search-modal[hidden] {
    display: none;
  }
  .search-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }
  .search-modal-content {
    position: relative;
    width: 90%;
    max-width: 640px;
    max-height: 70vh;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .search-modal-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .search-modal-header input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--sl-color-white);
    font-size: 1.1rem;
    outline: none;
  }
  .search-modal-header input::placeholder {
    color: var(--sl-color-gray-2);
  }
  #search-close {
    background: none;
    border: none;
    color: var(--sl-color-gray-1);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0.25rem;
    line-height: 1;
  }
  #search-close:hover {
    color: var(--phoenix-ember-hi);
  }
  .search-modal-results {
    overflow-y: auto;
    flex: 1;
    padding: 0.5rem;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .search-results li {
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .search-results li:last-child {
    border-bottom: none;
  }
  .search-results a {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--sl-color-gray-1);
    text-decoration: none;
  }
  .search-results a:hover {
    background: rgba(220, 38, 38, 0.06);
  }
  .search-results h4 {
    margin: 0 0 0.25rem;
    font-size: 0.95rem;
    color: var(--phoenix-ember-hi);
  }
  .search-results p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
  }
  .no-results {
    padding: 2rem;
    text-align: center;
    color: var(--sl-color-gray-2);
  }
</style>
